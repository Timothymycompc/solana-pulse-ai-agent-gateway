# Local development settings. In production these come from Google Secret Manager
# (secrets with the same names) and Cloud Run environment variables.

# Postgres connection string (required).
DATABASE_URL=postgres://user:password@localhost:5432/pulse

# Solana RPC endpoints. Without them the public, rate-limited clusters are used.
SOLANA_MAINNET_RPC_URL=
SOLANA_DEVNET_RPC_URL=

# Sent as x-api-key, gives the owner unlimited calls and access to /api/owner/payments.
OWNER_API_KEY=

# Key for hashing caller networks (free-call counts, usage stats). Any long random string.
CALLER_HASH_SECRET=

# x402 facilitator that verifies and settles USDC payments. Defaults to PayAI.
X402_FACILITATOR_URL=https://facilitator.payai.network

# Google Cloud project, used to read the secrets above from Secret Manager.
GCP_PROJECT_ID=
