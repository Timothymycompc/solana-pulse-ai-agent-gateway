{
  "name": "solana-pulse-gateway",
  "private": true,
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:site": "PULSE_API=https://solana-pulse-gateway-1021990235790.us-central1.run.app vite --host",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "prebuild": "npm run check",
    "start": "node dist/server.cjs",
    "check": "tsc --noEmit && tsx scripts/check-tools.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:record": "tsx tests/record-fixtures.ts",
    "benchmark": "tsx benchmark/run.ts",
    "benchmark:record": "tsx benchmark/record.ts",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "set-rpc-key": "bash scripts/set-rpc-key.sh",
    "set-jupiter-key": "bash scripts/set-jupiter-key.sh",
    "telegram-setup": "bash scripts/telegram-setup.sh",
    "accuracy-setup": "bash scripts/accuracy-setup.sh",
    "accuracy-rerun": "bash scripts/accuracy-rerun.sh",
    "accuracy": "curl -s -H \"x-api-key: $(gcloud secrets versions access latest --secret=OWNER_API_KEY)\" https://solana-pulse-gateway-1021990235790.us-central1.run.app/api/owner/accuracy | python3 -m json.tool",
    "secure-db": "bash scripts/secure-db.sh",
    "x-setup": "bash scripts/x-setup.sh",
    "x-key-1": "bash scripts/x-key.sh 1",
    "x-key-2": "bash scripts/x-key.sh 2",
    "x-key-3": "bash scripts/x-key.sh 3",
    "x-key-4": "bash scripts/x-key.sh 4",
    "x-check": "tsx scripts/x-check.ts",
    "x": "tsx scripts/x-tool/main.ts",
    "x-times": "tsx scripts/x-times.ts",
    "x-next": "tsx scripts/x-post.ts --next",
    "x-post": "tsx scripts/x-post.ts",
    "x-videos": "bash scripts/x-videos.sh",
    "everyday": "tsx benchmark/everyday-run.ts",
    "everyday:record": "tsx benchmark/everyday-run.ts record",
    "trial-key": "tsx scripts/trial-key.ts",
    "openapi": "tsx scripts/openapi.ts",
    "agent-kit": "tsx scripts/agent-kit.ts",
    "set-npm-token": "bash scripts/set-npm-token.sh",
    "publish-agent-kit": "bash scripts/publish-agent-kit.sh",
    "first-wallet": "tsx benchmark/first-wallet.ts",
    "first-wallet:refresh": "PULSE_OWNER_KEY=$(gcloud secrets versions access latest --secret=OWNER_API_KEY) tsx benchmark/first-wallet.ts refresh"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@google-cloud/secret-manager": "^7.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solana/kit": "^6.10.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.3.3",
    "@x402/core": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/mcp": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^1.35.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "esbuild": true,
    "bufferutil": true,
    "utf-8-validate@6.0.6": true
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  },
  "engines": {
    "node": ">=20.18"
  }
}
