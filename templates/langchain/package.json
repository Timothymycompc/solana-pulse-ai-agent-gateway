{
  "name": "pulse-template-langchain",
  "private": true,
  "type": "module",
  "description": "A LangChain agent that loads Solana Pulse's tools through the MCP adapter and checks every Solana transaction before signing. Dry run by default.",
  "scripts": {
    "start": "tsx src/agent.ts",
    "check": "tsx src/check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.0",
    "@langchain/mcp-adapters": "^2.0.1",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "langchain": "^1.5.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
